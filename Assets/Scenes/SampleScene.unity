  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HippoGame.UI.UILocalizer
  _entries:
  - target: {fileID: 223739037}
    ru: "\u041B\u0435\u0433\u043A\u0430\u044F"
    en: Easy
  - target: {fileID: 170335653}
    ru: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F"
    en: Medium
  - target: {fileID: 1909414347}
    ru: "\u0421\u043B\u043E\u0436\u043D\u0430\u044F"
    en: Difficult
  - target: {fileID: 303287533}
    ru: "\u0421\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
    en: Complexity
  - target: {fileID: 1025120192}
    ru: "\u041F\u043B\u044E\u0441 1 \u0436\u0438\u0437\u043D\u044C"
    en: Plus 1 life
  - target: {fileID: 1607705197}
    ru: "\u041C\u0438\u043D\u0443\u0441 1 \u0448\u0430\u0440"
    en: Minus 1 ball
  - target: {fileID: 1007511310}
    ru: "\u041C\u0438\u043D\u0443\u0441 20% \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0448\u0430\u0440\u0430\u043C"
    en: Minus 20% speed for balls
  - target: {fileID: 131385638}
    ru: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D"
    en: Shop
  - target: {fileID: 1724111}
    ru: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    en: Close
  - target: {fileID: 789433389}
    ru: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
    en: Close
  - target: {fileID: 433333312}
    ru: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0438\u0433\u0440\u044B \"\u041A\u0441\u043E\u043D\u0438\u043A\u0441-\u0411\u0435\u0433\u0435\u043C\u043E\u0442.
      \u041D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C.\""
    en: Rules of the game "Xonics-Behemoth. New level."
  - target: {fileID: 573383864}
    ru: "\u0426\u0435\u043B\u044C\r\n\u0417\u0430\u043A\u0440\u0430\u0441\u044C \u043A\u0430\u043A
      \u043C\u043E\u0436\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u043B\u044F,
      \u043E\u0442\u0440\u0435\u0437\u0430\u044F \u043A\u0443\u0441\u043A\u0438 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438!\r\n\r\n\u041A\u0430\u043A
      \u0438\u0433\u0440\u0430\u0442\u044C\r\n\r\n\u0411\u0435\u0433\u0435\u043C\u043E\u0442
      \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u043F\u043E \u043F\u043E\u043B\u044E\r\n\u041F\u043E
      \u043A\u0440\u0430\u044F\u043C \u2014 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430\u044F
      \u0437\u043E\u043D\u0430, \u0442\u0430\u043C \u0432\u0440\u0430\u0433\u0438
      \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043D\u0443\u0442\r\n\u0412\u044B\u0435\u0445\u0430\u043B
      \u0432 \u043F\u043E\u043B\u0435 \u2192 \u0437\u0430 \u0442\u043E\u0431\u043E\u0439
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043B\u0438\u043D\u0438\u044F\r\n\u0412\u0435\u0440\u043D\u0438\u0441\u044C
      \u043A \u043A\u0440\u0430\u044E \u2014 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F
      \u0437\u0430\u043A\u0440\u0430\u0441\u0438\u0442\u0441\u044F\r\n\u0417\u0430\u043A\u0440\u0430\u0441\u044C
      60\u201385% \u043F\u043E\u043B\u044F (\u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438) \u2014
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D!\r\n\u041D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u043D\u043E\u0432\u043E\u043C \u0443\u0440\u043E\u0432\u043D\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435\r\n\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448
      \u0435\u0441\u043B\u0438...\r\n\r\n\u0412\u0440\u0430\u0433 \u0437\u0430\u0434\u0435\u043B
      \u0442\u0432\u043E\u044E \u043B\u0438\u043D\u0438\u044E \u043F\u043E\u043A\u0430
      \u0442\u044B \u0435\u0451 \u0440\u0438\u0441\u0443\u0435\u0448\u044C\r\n\u0412\u0440\u0430\u0433
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0432\u043D\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
      \u0437\u043E\u043D\u044B\r\n\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C
      \u0432\u0441\u0435 \u0436\u0438\u0437\u043D\u0438 \u2014 Game Over\r\n\u0421\u043E\u0432\u0435\u0442\r\n\r\n\u0417\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0439
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438
      \u2014 \u044D\u0442\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435.\r\n\u0421\u043B\u0435\u0434\u0438
      \u0437\u0430 \u0432\u0440\u0430\u0433\u0430\u043C\u0438 \u0438 \u043E\u0442\u0440\u0435\u0437\u0430\u0439
      \u0438\u0445 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443.\r\n\u0414\u043B\u0438\u043D\u043D\u0430\u044F
      \u043B\u0438\u043D\u0438\u044F = \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0440\u0438\u0441\u043A!"
    en: "Goal\r\nCapture as much of the field as possible by cutting off pieces of
      territory!\r\n\r\nHow to play\r\n\r\nYou control the Hippo moving across the
      field\r\nThe edges are a safe zone \u2014 enemies can't get you there\r\nMove
      into the field \u2192 a trail appears behind you\r\nReturn to the edge \u2014
      the territory gets filled in\r\nFill 60\u201385% of the field (depends on difficulty)
      \u2014 level complete!\r\nEach new level brings more enemies\r\nYou lose if...\r\n\r\nAn
      enemy hits your trail while you're drawing it\r\nAn enemy collides with you
      outside the safe zone\r\nYou run out of lives \u2014 Game Over\r\nTips\r\n\r\nCapture
      small areas \u2014 it's much safer.\r\nWatch where the enemies are and cut
      them off one by one.\r\nLong trails = big risk!"
  - target: {fileID: 132838335}
    ru: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u0438\u0433\u0440\u044B"
    en: Rules of the game
  - target: {fileID: 26400003}
    ru: "\u0418\u0433\u0440\u0430 \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u0430"
    en: Game over
  - target: {fileID: 1796770493}
    ru: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0437\u0430
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440 \u0440\u0435\u043A\u043B\u0430\u043C\u044B"
    en: Continue watching ads
  - target: {fileID: 527126202}
    ru: "\u0417\u0430\u043D\u043E\u0432\u043E \u0441 1-\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F"
    en: Start from level 1
  - target: {fileID: 1627730617}
    ru: "\u0422\u0430\u0431\u043B\u0438\u0446\u0430 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0430"
    en: Rating table
  - target: {fileID: 1627730617}
    ru: "\u0422\u0430\u0431\u043B\u0438\u0446\u0430 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u0430"
    en: Rating table
  - target: {fileID: 1599645994}
    ru: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D"
    en: Shop
  - target: {fileID: 660644935}
    ru: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435"
    en: Attention
  - target: {fileID: 376076682}
    ru: "\u041F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0439
      \u0440\u043E\u043B\u0438\u043A, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443?"
    en: Watch the ad to continue playing?
  - target: {fileID: 880194393}
    ru: "\u0414\u0430"
    en: Yes
  - target: {fileID: 455380241}
    ru: "\u041D\u0435\u0442"
    en: No
  - target: {fileID: 1134514118}
    ru: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u043D\u0430\u0447\u0430\u043B\u0430"
    en: Restart
